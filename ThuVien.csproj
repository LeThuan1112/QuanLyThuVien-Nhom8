<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ThuVien</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <!-- Do not compile C# sources from nested utility/test projects into the web app. -->
  <ItemGroup>
    <Compile Remove="AdminPasswordReset/**/*.cs" />
    <Compile Remove="tests/**/*.cs" />
    <Content Remove="AdminPasswordReset/**" />
    <Content Remove="tests/**" />
    <None Remove="AdminPasswordReset/**" />
    <None Remove="tests/**" />
  </ItemGroup>
</Project>
