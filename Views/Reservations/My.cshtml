@model List<BookReservation>
@{
    ViewData["Title"] = L["Reservation_MyTitle"].Value;
    var linked = ViewBag.ReaderLinked is bool b && b;
    var queuePositions = ViewBag.QueuePositions as Dictionary<int, int> ?? new Dictionary<int, int>();
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">@L["Reservation_MyTitle"]</h1>
        <p class="text-muted mb-0">@L["Reservation_MySubtitle"]</p>
    </div>
    <a class="btn btn-outline-primary" asp-controller="Books" asp-action="Index"><i class="bi bi-search"></i> @L["Nav_Books"]</a>
</div>
@if (!linked)
{
    <div class="alert alert-warning">Tài khoản của bạn chưa được liên kết với hồ sơ độc giả. Vui lòng liên hệ thủ thư.</div>
}
else if (!Model.Any())
{
    <div class="card border-0 shadow-sm"><div class="card-body text-center py-5">
        <i class="bi bi-bookmark-plus display-5 text-primary"></i>
        <h2 class="h5 mt-3">@L["Reservation_EmptyTitle"]</h2>
        <p class="text-muted">@L["Reservation_EmptyBody"]</p>
        <a class="btn btn-primary" asp-controller="Books" asp-action="Index">@L["Reservation_Browse"]</a>
    </div></div>
}
else
{
    <div class="card border-0 shadow-sm"><div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light"><tr><th>@L["Col_Title"]</th><th>@L["Reservation_RequestedAt"]</th><th>@L["Reservation_Status"]</th><th>@L["Reservation_ExpiresAt"]</th><th class="text-end">@L["Col_Actions"]</th></tr></thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><a asp-controller="Books" asp-action="Details" asp-route-id="@item.BookId" class="fw-semibold text-decoration-none">@item.Book?.Title</a><div class="small text-muted">@item.Book?.Author</div></td>
                    <td>@item.RequestedAt.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        @if (item.Status == ReservationStatuses.Ready)
                        {
                            <span class="badge text-bg-success">@L["Reservation_Ready"]</span>
                        }
                        else if (item.Status == ReservationStatuses.Waiting)
                        {
                            <span class="badge text-bg-warning">@L["Reservation_Waiting"]</span>
                            @if (queuePositions.TryGetValue(item.BookReservationId, out var queuePosition))
                            {
                                <div class="small text-muted mt-1">@L["Reservation_QueuePosition", queuePosition]</div>
                            }
                        }
                        else if (item.Status == ReservationStatuses.Fulfilled)
                        {
                            <span class="badge text-bg-primary">@L["Reservation_Fulfilled"]</span>
                        }
                        else if (item.Status == ReservationStatuses.Cancelled)
                        {
                            <span class="badge text-bg-secondary">@L["Reservation_Cancelled"]</span>
                        }
                        else if (item.Status == ReservationStatuses.Expired)
                        {
                            <span class="badge text-bg-danger">@L["Reservation_Expired"]</span>
                        }
                    </td>
                    <td>@(item.ExpiresAt.HasValue ? item.ExpiresAt.Value.ToString("dd/MM/yyyy HH:mm") : "—")</td>
                    <td class="text-end">
                        @if (item.Status == ReservationStatuses.Waiting || item.Status == ReservationStatuses.Ready)
                        {
                            <form asp-action="Cancel" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@item.BookReservationId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">@L["Reservation_Cancel"]</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div></div>
}
<div class="alert alert-info mt-3 small"><i class="bi bi-info-circle me-1"></i>@L["Reservation_Rules"]</div>
