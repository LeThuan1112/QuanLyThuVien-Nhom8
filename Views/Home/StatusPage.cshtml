@{
    ViewData["Title"] = "Thông báo";
    var code = (int)(ViewBag.Code ?? 0);
}
<div class="text-center py-5">
    <h1 class="display-4">@code</h1>
    @if (code == 404)
    {
        <p class="lead">Không tìm thấy trang bạn yêu cầu.</p>
    }
    else if (code == 403)
    {
        <p class="lead">Bạn không có quyền truy cập trang này.</p>
    }
    else
    {
        <p class="lead">Đã xảy ra sự cố khi xử lý yêu cầu.</p>
    }
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Về trang chủ</a>
</div>
