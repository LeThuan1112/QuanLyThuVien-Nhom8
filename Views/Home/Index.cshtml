@model HomeViewModel
@{
    ViewData["Title"] = L["Nav_Home"].Value;
}
<section class="hero mb-4">
    <div class="row position-relative" style="z-index:1">
        <div class="col-lg-9">
            <span class="badge rounded-pill text-bg-light text-primary mb-3"><i class="bi bi-book-half me-1"></i>@L["App_Name"]</span>
            <h1 class="display-5 fw-bold mb-3">@L["Hero_Title"]</h1>
            <p class="lead opacity-75 mb-4">@L["Hero_Sub"]</p>
            <form asp-controller="Books" asp-action="Index" method="get" class="hero-search">
                <div class="input-group input-group-lg">
                    <span class="input-group-text bg-white border-0"><i class="bi bi-search"></i></span>
                    <input type="text" name="keyword" class="form-control border-0" placeholder="@L["Hero_SearchPh"]" aria-label="@L["Hero_SearchPh"]" />
                    <button class="btn btn-warning fw-semibold px-4" type="submit">@L["Hero_SearchBtn"]</button>
                </div>
                <div class="small opacity-75 mt-2">@L["Books_SearchPh"]</div>
            </form>
        </div>
    </div>
</section>

<div class="row g-3 mb-5">
    <div class="col-12 col-md-4"><div class="card kpi h-100"><div class="kpi-icon bg-soft-primary"><i class="bi bi-book"></i></div><div><div class="label">@L["Home_StatBooks"]</div><div class="value">@Model.BookTitles</div></div></div></div>
    <div class="col-12 col-md-4"><div class="card kpi h-100"><div class="kpi-icon bg-soft-success"><i class="bi bi-check2-circle"></i></div><div><div class="label">@L["Home_StatAvail"]</div><div class="value">@Model.AvailableCopies</div></div></div></div>
    <div class="col-12 col-md-4"><div class="card kpi h-100"><div class="kpi-icon bg-soft-info"><i class="bi bi-people"></i></div><div><div class="label">@L["Home_StatReaders"]</div><div class="value">@Model.Readers</div></div></div></div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h5 mb-0"><i class="bi bi-grid me-2 text-primary"></i>@L["Home_Categories"]</h2>
    <a asp-controller="Books" asp-action="Index" class="small text-decoration-none">@L["Home_ViewAll"] <i class="bi bi-arrow-right"></i></a>
</div>
@if (Model.Categories.Any())
{
    <div class="d-flex flex-wrap gap-2 mb-5">
        @foreach (var c in Model.Categories)
        {
            <a class="chip" asp-controller="Books" asp-action="Index" asp-route-categoryId="@c.Id">@c.Name <span>@c.Count</span></a>
        }
    </div>
}
else
{
    <div class="alert alert-light border mb-5">@L["Books_Empty"]</div>
}

<section class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div><h2 class="h5 mb-1">@L["Home_Latest"]</h2><p class="text-muted small mb-0">@L["Home_Subtitle"]</p></div>
        <a asp-controller="Books" asp-action="Index" class="btn btn-sm btn-outline-primary">@L["Home_ViewAll"] <i class="bi bi-arrow-right"></i></a>
    </div>
    @if (Model.LatestBooks.Any())
    {
        <div class="row g-3">
        @foreach (var b in Model.LatestBooks)
        {
            <div class="col-6 col-md-4 col-xl-2">
                <a asp-controller="Books" asp-action="Details" asp-route-id="@b.BookId" class="text-decoration-none text-reset">
                    <div class="card book-card h-100">
                        <div class="book-cover book-cover-home">
                            @if (!string.IsNullOrWhiteSpace(b.CoverImageUrl))
                            {
                                <img src="@b.CoverImageUrl" alt="@L["Book_CoverMissing"]: @b.Title" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='grid'" />
                                <span class="cover-placeholder" style="display:none">@(string.IsNullOrWhiteSpace(b.Title) ? "?" : b.Title.Trim()[0].ToString().ToUpperInvariant())</span>
                            }
                            else
                            {
                                <span class="cover-placeholder">@(string.IsNullOrWhiteSpace(b.Title) ? "?" : b.Title.Trim()[0].ToString().ToUpperInvariant())</span>
                            }
                        </div>
                        <div class="card-body p-3 d-flex flex-column">
                            <div class="fw-semibold book-card-title" title="@b.Title">@b.Title</div>
                            <div class="small text-muted text-truncate mt-1">@b.Author</div>
                            <div class="mt-auto pt-3">@if (b.AvailableCopies > 0) { <span class="badge text-bg-success">@L["Status_Available"]</span> } else { <span class="badge text-bg-secondary">@L["Status_Out"]</span> }</div>
                        </div>
                    </div>
                </a>
            </div>
        }
        </div>
    }
    else { <div class="alert alert-light border">@L["Books_Empty"]</div> }
</section>

<section class="mb-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div><h2 class="h5 mb-1">@L["Home_PopularTitle"]</h2><p class="text-muted small mb-0">@L["Home_PopularSubtitle"]</p></div>
        <a asp-controller="Books" asp-action="Index" class="btn btn-sm btn-outline-primary">@L["Home_ViewAll"] <i class="bi bi-arrow-right"></i></a>
    </div>
    @if (Model.PopularBooks.Any())
    {
        <div class="row g-3">
        @foreach (var b in Model.PopularBooks)
        {
            <div class="col-6 col-md-4 col-xl-2">
                <a asp-controller="Books" asp-action="Details" asp-route-id="@b.BookId" class="text-decoration-none text-reset">
                    <div class="card book-card h-100">
                        <div class="book-cover book-cover-home">
                            @if (!string.IsNullOrWhiteSpace(b.CoverImageUrl))
                            {
                                <img src="@b.CoverImageUrl" alt="@b.Title" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='grid'" />
                                <span class="cover-placeholder" style="display:none">@(string.IsNullOrWhiteSpace(b.Title) ? "?" : b.Title.Trim()[0].ToString().ToUpperInvariant())</span>
                            }
                            else { <span class="cover-placeholder">@(string.IsNullOrWhiteSpace(b.Title) ? "?" : b.Title.Trim()[0].ToString().ToUpperInvariant())</span> }
                        </div>
                        <div class="card-body p-3"><div class="fw-semibold book-card-title" title="@b.Title">@b.Title</div><div class="small text-muted text-truncate mt-1">@b.Author</div><div class="small mt-2 text-primary"><i class="bi bi-arrow-up-right-circle me-1"></i>@L["Btn_Details"]</div></div>
                    </div>
                </a>
            </div>
        }
        </div>
    }
    else { <div class="alert alert-light border">@L["Home_PopularEmpty"]</div> }
</section>
