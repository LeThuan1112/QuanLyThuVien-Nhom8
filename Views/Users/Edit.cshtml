@model UserEditViewModel
@{
    ViewData["Title"] = "Sửa tài khoản";
    var roles = (IEnumerable<SelectListItem>)ViewBag.Roles;
    var readers = (IEnumerable<SelectListItem>)ViewBag.Readers;
    var isSelf = ViewBag.IsSelf is bool b && b;
}
<div class="row justify-content-center">
    <div class="col-12 col-lg-7">
        <div class="card">
            <div class="card-body p-4">
                <h1 class="h4 mb-1">Sửa tài khoản</h1>
                <div class="text-muted mb-3">Tên đăng nhập: <strong>@Model.Username</strong></div>
                @if (isSelf)
                {
                    <div class="alert alert-info py-2">Đây là tài khoản của bạn: không thể tự đổi vai trò hoặc tự khóa.</div>
                }
                <form asp-action="Edit" asp-route-id="@Model.UserId" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
                    <input type="hidden" asp-for="UserId" />
                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label"></label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Role" class="form-label"></label>
                        <select asp-for="Role" asp-items="roles" class="form-select" disabled="@isSelf"></select>
                        @if (isSelf)
                        {
                            <input type="hidden" asp-for="Role" />
                        }
                        <span asp-validation-for="Role" class="text-danger small"></span>
                    </div>
                    <div class="mb-3" id="readerLink">
                        <label asp-for="ReaderId" class="form-label"></label>
                        <select asp-for="ReaderId" asp-items="readers" class="form-select">
                            <option value="">-- Chọn hồ sơ độc giả --</option>
                        </select>
                        <div class="form-text">Tài khoản có vai trò Độc giả phải được liên kết với một hồ sơ độc giả có sẵn. Nếu danh sách trống, hãy tạo hồ sơ tại mục Quản lý độc giả trước.</div>
                        <span asp-validation-for="ReaderId" class="text-danger small"></span>
                    </div>
                    <div class="form-check mb-4">
                        <input asp-for="IsActive" class="form-check-input" disabled="@isSelf" />
                        <label asp-for="IsActive" class="form-check-label"></label>
                        @if (isSelf)
                        {
                            <input type="hidden" name="IsActive" value="true" />
                        }
                    </div>
                    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                    <a class="btn btn-outline-secondary" asp-action="Index">Hủy</a>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        $(function () {
            function toggleReader() {
                $('#readerLink').toggle($('#Role').val() === 'Reader');
            }
            $('#Role').on('change', toggleReader);
            toggleReader();
        });
    </script>
}
