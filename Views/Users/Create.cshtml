@model UserCreateViewModel
@{
    ViewData["Title"] = "Tạo tài khoản";
    var roles = (IEnumerable<SelectListItem>)ViewBag.Roles;
    var readers = (IEnumerable<SelectListItem>)ViewBag.Readers;
}
<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="card">
            <div class="card-body p-4">
                <h1 class="h4 mb-3">Tạo tài khoản mới</h1>
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Username" class="form-label"></label>
                            <input asp-for="Username" class="form-control" autocomplete="off" />
                            <span asp-validation-for="Username" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label"></label>
                            <input asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Role" class="form-label"></label>
                            <select asp-for="Role" asp-items="roles" class="form-select"></select>
                            <span asp-validation-for="Role" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label"></label>
                            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                        <div class="col-12" id="readerLink">
                            <label asp-for="ReaderId" class="form-label"></label>
                            <select asp-for="ReaderId" asp-items="readers" class="form-select">
                                <option value="">-- Không gắn --</option>
                            </select>
                            <div class="form-text">Chỉ hiện các hồ sơ độc giả chưa có tài khoản. Gắn hồ sơ để độc giả xem được phiếu mượn của mình.</div>
                            <span asp-validation-for="ReaderId" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="mt-4">
                        <button type="submit" class="btn btn-primary">Tạo tài khoản</button>
                        <a class="btn btn-outline-secondary" asp-action="Index">Hủy</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            function toggleReader() {
                $('#readerLink').toggle($('#Role').val() === 'Reader');
            }
            $('#Role').on('change', toggleReader);
            toggleReader();
        });
    </script>
}
