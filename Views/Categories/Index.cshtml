@model List<Category>
@{
    ViewData["Title"] = "Thể loại";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Thể loại sách</h1>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> Thêm thể loại</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-warning">Chưa có thể loại nào.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle bg-white border">
            <thead class="table-light">
                <tr>
                    <th>Tên thể loại</th>
                    <th>Mô tả</th>
                    <th class="text-center">Số đầu sách</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@c.Name</td>
                        <td>@c.Description</td>
                        <td class="text-center">@c.Books.Count</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@c.CategoryId" class="btn btn-sm btn-outline-primary">Sửa</a>
                            <form asp-action="Delete" asp-route-id="@c.CategoryId" method="post" class="d-inline"
                                  onsubmit="return confirm('Bạn có chắc muốn xóa thể loại này?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
