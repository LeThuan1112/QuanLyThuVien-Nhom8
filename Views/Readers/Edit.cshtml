@model Reader
@{
    ViewData["Title"] = "Sửa độc giả";
}
<h1 class="h3 mb-3">Sửa độc giả</h1>
<div class="card">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.ReaderId" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
            <input type="hidden" asp-for="ReaderId" />
            <partial name="_ReaderFields" model="Model" />
            <div class="mt-4">
                <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Hủy</a>
            </div>
        </form>
    </div>
</div>
